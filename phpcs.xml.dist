<?xml version="1.0"?>
<ruleset name="GB Block Filter"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

	<description>WordPress Coding Standards für das Plugin Block Inserter Filter (Prefix jgor_bif).</description>

	<!-- Zu prüfende Dateien: das Plugin selbst -->
	<file>.</file>

	<!-- Ausschlüsse -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<!-- Nur fuer PHPStan, definiert WP-Konstanten (kein Plugin-Prefix moeglich) -->
	<exclude-pattern>*/phpstan-bootstrap.php</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<!-- Laufzeitoptionen: nur PHP, Sniff-Codes anzeigen, Fortschritt, Farben, parallel, Cache -->
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<!-- Zielversionen (siehe Plugin-Header: Requires PHP 8.0, Requires at least 6.0) -->
	<config name="testVersion" value="8.0-"/>
	<config name="minimum_supported_wp_version" value="6.0"/>

	<!-- Vollständiger WordPress-Standard (Core, Docs, Extra) -->
	<rule ref="WordPress"/>

	<!-- PHP-Kompatibilität ab testVersion -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Prefix-Prüfung: Funktionen jgor_bif_, Klassen JGOR_BIF_, Konstanten JGOR_BIF_,
	     Hooks/Optionen jgor_bif_, Handles jgor-bif- -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="jgor_bif"/>
			</property>
		</properties>
	</rule>

	<!-- Text-Domain = Plugin-Slug -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="block-inserter-filter"/>
			</property>
		</properties>
	</rule>

</ruleset>
