# Uebersetzungen: nur de_DE und en_GB werden mitgeliefert. Die uebrigen
# Sprachen bleiben im Repo und werden ueber translate.wordpress.org
# (GlotPress) eingereicht, dort entstehen dann die Sprachpakete.
languages/block-inserter-filter-es_ES.*
languages/block-inserter-filter-fr_FR.*
languages/block-inserter-filter-it_IT.*
languages/block-inserter-filter-ja.*
languages/block-inserter-filter-nl_NL.*
languages/block-inserter-filter-pl_PL.*
languages/block-inserter-filter-pt_BR.*
languages/block-inserter-filter-ru_RU.*
