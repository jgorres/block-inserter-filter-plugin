# Files and directories of plugin/ that stay out of the release ZIP and the
# SVN export. The list lives next to build.sh, not inside plugin/: a hidden
# file in the plugin folder makes Plugin Check warn on development sites,
# which load that folder through a symlink.
.distignore
.DS_Store
Thumbs.db
*.swp
*.zip

# Translations: the WordPress.org plugin team rejects packages with bundled
# translation files (review of 16.09.2026). Languages are handled through
# translate.wordpress.org; from languages/ only index.php and the .pot
# template are shipped.
languages/*.po
languages/*.mo
languages/*.json
languages/*.l10n.php
