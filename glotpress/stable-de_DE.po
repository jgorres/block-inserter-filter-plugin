#: includes/class-jgor-bif-plugin.php:196
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-jgor-bif-admin-page.php:684
msgid "Uncategorized"
msgstr "Ohne Kategorie"

#: includes/class-jgor-bif-admin-page.php:628
msgid "Variations of the \"Embed\" block (YouTube, Reddit, Vimeo, …). Checked variations are removed in the editor; the base \"Embed\" block remains available."
msgstr "Varianten des Blocks „Einbetten“ (YouTube, Reddit, Vimeo, …). Markierte Varianten werden im Editor entfernt; der Basis-Block „Einbetten“ bleibt verfügbar."

#: includes/class-jgor-bif-admin-page.php:616
msgid "Embed variations"
msgstr "Einbettungsvarianten"

#: includes/class-jgor-bif-admin-page.php:570
#: includes/class-jgor-bif-admin-page.php:651
msgid "Save"
msgstr "Speichern"

#: includes/class-jgor-bif-admin-page.php:563
msgid "protected"
msgstr "geschützt"

#: includes/class-jgor-bif-admin-page.php:561
msgid "Pro variant active"
msgstr "Pro-Variante aktiv"

#: includes/class-jgor-bif-admin-page.php:560
msgid "GenerateBlocks Pro is active. This core block is hidden from the inserter automatically because GenerateBlocks Pro provides an extended variant. If GenerateBlocks Pro is deactivated, the core block reappears automatically."
msgstr "GenerateBlocks Pro ist aktiv. Dieser Core-Block wird automatisch aus dem Inserter ausgeblendet, weil GenerateBlocks Pro eine erweiterte Variante mitbringt. Wird GenerateBlocks Pro deaktiviert, erscheint der Core-Block automatisch wieder."

#: includes/class-jgor-bif-admin-page.php:505
#: includes/class-jgor-bif-admin-page.php:624
msgid "Toggle all"
msgstr "Alle umschalten"

#. translators: %d: number of hidden blocks in this group.
#. translators: %d: number of hidden embed variations in this group.
#: includes/class-jgor-bif-admin-page.php:474
#: includes/class-jgor-bif-admin-page.php:605
msgid "%d hidden"
msgstr "%d ausgeblendet"

#: includes/class-jgor-bif-admin-page.php:439
msgid "Save Settings"
msgstr "Einstellungen speichern"

#: includes/class-jgor-bif-admin-page.php:436
msgid "No blocks found."
msgstr "Keine Blöcke gefunden."

#: includes/class-jgor-bif-admin-page.php:404
msgid "By namespace"
msgstr "Nach Namensraum"

#: includes/class-jgor-bif-admin-page.php:400
msgid "By category"
msgstr "Nach Kategorie"

#: includes/class-jgor-bif-admin-page.php:397
msgid "Choose grouping"
msgstr "Gruppierung wählen"

#: includes/class-jgor-bif-admin-page.php:391
msgid "Search blocks…"
msgstr "Blöcke durchsuchen…"

#: includes/class-jgor-bif-admin-page.php:386
msgid "Search blocks"
msgstr "Blöcke durchsuchen"

#: includes/class-jgor-bif-admin-page.php:381
msgid "Certain core blocks (Paragraph, Heading, List, Image, Group, Columns) always stay available as a safety net and cannot be hidden here."
msgstr "Bestimmte Core-Blöcke (Absatz, Überschrift, Liste, Bild, Gruppe, Spalten) sind als Sicherheitsnetz immer aktiv und können hier nicht deaktiviert werden."

#: includes/class-jgor-bif-admin-page.php:380
msgid "Checked blocks are removed from the block inserter for all users. Existing content using hidden blocks remains visible – only inserting new instances is blocked."
msgstr "Markierte Blöcke werden für alle Benutzer aus dem Block-Inserter entfernt. Bestehende Inhalte mit ausgeblendeten Blöcken bleiben sichtbar – nur das Einfügen neuer Instanzen ist gesperrt."

#. translators: 1: number of registered blocks, 2: number of hidden blocks, 3:
#. number of hidden embed variations.
#: includes/class-jgor-bif-admin-page.php:371
msgid "Registered blocks: %1$d. Currently hidden: %2$d blocks and %3$d embed variations."
msgstr "Insgesamt registriert: %1$d Blöcke. Aktuell ausgeblendet: %2$d Blöcke und %3$d Einbettungsvarianten."

