msgid "Hide Blocks"
msgstr "Blöcke ausblenden"

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Blendet einzelne Gutenberg-Blöcke und Embed-Varianten websiteweit aus dem Block-Inserter aus. Konfigurierbar pro Block durch Administratoren, mit optionaler GenerateBlocks-Integration."

#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"