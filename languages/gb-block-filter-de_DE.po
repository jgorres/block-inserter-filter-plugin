#. Plugin Name of the plugin
#: gb-block-filter.php
msgid "Block Filter for GenerateBlocks"
msgstr "Block-Filter für GenerateBlocks"

#. Description of the plugin
#: gb-block-filter.php
msgid "Hides individual Gutenberg blocks (Core, GenerateBlocks Free, GenerateBlocks Pro, theme and plugin blocks) globally from the block inserter. Configurable per block by administrators."
msgstr "Blendet einzelne Gutenberg-Blöcke (Core, GenerateBlocks Free, GenerateBlocks Pro, Theme- und Plugin-Blöcke) global aus dem Block-Inserter aus. Konfigurierbar pro Block durch Administratoren."

#. Author of the plugin
#: gb-block-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: gb-block-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

