#. translators: 1: number of registered blocks, 2: number of hidden blocks, 3: number of hidden embed variations.
#: includes/class-jg-gbbf-admin-page.php:368
#, php-format
msgid "Registered blocks: %1$d. Currently hidden: %2$d blocks and %3$d embed variations."
msgstr "Insgesamt registriert: %1$d Blöcke. Aktuell ausgeblendet: %2$d Blöcke und %3$d Embed-Varianten."

#: includes/class-jg-gbbf-admin-page.php:377
msgid "Checked blocks are removed from the block inserter for all users. Existing content using hidden blocks remains visible – only inserting new instances is blocked."
msgstr "Markierte Blöcke werden für alle Nutzer aus dem Block-Inserter entfernt. Bestehende Inhalte mit ausgeblendeten Blöcken bleiben sichtbar – nur das Einfügen neuer Instanzen ist gesperrt."

#: includes/class-jg-gbbf-admin-page.php:379
msgid "Certain core blocks (Paragraph, Heading, List, Image, Group, Columns) always stay available as a safety net and cannot be hidden here."
msgstr "Bestimmte Kern-Blöcke (Absatz, Überschrift, Liste, Bild, Gruppe, Spalten) sind als Sicherheitsnetz immer aktiv und können hier nicht deaktiviert werden."

