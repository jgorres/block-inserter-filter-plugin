#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Oculta blocos individuais do Gutenberg e variações de incorporação do insersor de blocos em todo o site. Configurável por bloco pelos administradores, com integração opcional ao GenerateBlocks."

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

