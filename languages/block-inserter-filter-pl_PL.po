#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Ukrywa pojedyncze bloki Gutenberga i warianty osadzania z narzędzia wstawiania bloków w całej witrynie. Konfigurowane przez administratorów dla każdego bloku, z opcjonalną integracją z GenerateBlocks."

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

