#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Ukrywa pojedyncze bloki Gutenberga i warianty osadzania z narzędzia wstawiania bloków w całej witrynie. Konfigurowane przez administratorów dla każdego bloku, z opcjonalną integracją z GenerateBlocks."

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

#: includes/class-jgor-bif-admin-page.php:61
#: includes/class-jgor-bif-admin-page.php:62
#: includes/class-jgor-bif-admin-page.php:365
msgid "Hide Blocks"
msgstr "Ukryj bloki"

#: includes/class-jgor-bif-admin-page.php:139
#: includes/class-jgor-bif-admin-page.php:140
#: includes/class-jgor-bif-admin-page.php:228
#: includes/class-jgor-bif-admin-page.php:229
msgid "You do not have permission to do this."
msgstr "Nie masz uprawnień do wykonania tej czynności."

#. translators: 1: number of registered blocks, 2: number of hidden blocks, 3: number of hidden embed variations.
#: includes/class-jgor-bif-admin-page.php:371
#, php-format
msgid "Registered blocks: %1$d. Currently hidden: %2$d blocks and %3$d embed variations."
msgstr "Zarejestrowane bloki: %1$d. Obecnie ukryte: %2$d bloków i %3$d wariantów osadzania."

#: includes/class-jgor-bif-admin-page.php:380
msgid "Checked blocks are removed from the block inserter for all users. Existing content using hidden blocks remains visible – only inserting new instances is blocked."
msgstr "Zaznaczone bloki są usuwane z narzędzia wstawiania bloków dla wszystkich użytkowników. Istniejąca treść z ukrytymi blokami pozostaje widoczna – blokowane jest tylko wstawianie nowych wystąpień."

#: includes/class-jgor-bif-admin-page.php:381
msgid "Certain core blocks (Paragraph, Heading, List, Image, Group, Columns) always stay available as a safety net and cannot be hidden here."
msgstr "Niektóre bloki podstawowe (Akapit, Nagłówek, Lista, Obrazek, Grupa, Kolumny) są zawsze dostępne jako zabezpieczenie i nie można ich tutaj ukryć."

