#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Masque certains blocs Gutenberg et variations d’intégration dans l’outil d’insertion de blocs, pour tout le site. Configurable bloc par bloc par les administrateurs, avec une intégration GenerateBlocks optionnelle."

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

