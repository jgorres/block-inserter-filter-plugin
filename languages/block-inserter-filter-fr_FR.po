#. translators: 1: number of registered blocks, 2: number of hidden blocks, 3: number of hidden embed variations.
#: includes/class-jgor-bif-admin-page.php:375
#, php-format
msgid "Registered blocks: %1$d. Currently hidden: %2$d blocks and %3$d embed variations."
msgstr "Blocs enregistrés : %1$d. Actuellement masqués : %2$d blocs et %3$d variations d’intégration."

#: includes/class-jgor-bif-admin-page.php:384
msgid "Checked blocks are removed from the block inserter for all users. Existing content using hidden blocks remains visible – only inserting new instances is blocked."
msgstr "Les blocs cochés sont retirés de l’outil d’insertion pour tous les utilisateurs. Le contenu existant utilisant des blocs masqués reste visible – seule l’insertion de nouvelles instances est bloquée."

#: includes/class-jgor-bif-admin-page.php:385
msgid "Certain core blocks (Paragraph, Heading, List, Image, Group, Columns) always stay available as a safety net and cannot be hidden here."
msgstr "Certains blocs de base (Paragraphe, Titre, Liste, Image, Groupe, Colonnes) restent toujours disponibles par sécurité et ne peuvent pas être masqués ici."

