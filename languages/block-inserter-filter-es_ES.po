#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Oculta bloques individuales de Gutenberg y variaciones de incrustación del insertador de bloques en todo el sitio. Configurable por bloque por los administradores, con integración opcional de GenerateBlocks."

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

