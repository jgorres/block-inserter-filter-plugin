#. Plugin Name of the plugin
#: gb-block-filter.php
msgid "Block Filter for GenerateBlocks"
msgstr "Filtro de bloques para GenerateBlocks"

#. Description of the plugin
#: gb-block-filter.php
msgid "Hides individual Gutenberg blocks (Core, GenerateBlocks Free, GenerateBlocks Pro, theme and plugin blocks) globally from the block inserter. Configurable per block by administrators."
msgstr "Oculta globalmente bloques individuales de Gutenberg (Core, GenerateBlocks Free, GenerateBlocks Pro, bloques de temas y plugins) del insertador de bloques. Configurable por bloque por los administradores."

#. Author of the plugin
#: gb-block-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: gb-block-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

