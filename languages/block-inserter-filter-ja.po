#. Plugin Name of the plugin
#: block-inserter-filter.php
msgid "Block Inserter Filter"
msgstr "Block Inserter Filter"

#. Description of the plugin
#: block-inserter-filter.php
msgid "Hides individual Gutenberg blocks and embed variations from the block inserter, site-wide. Configurable per block by administrators, with optional GenerateBlocks integration."
msgstr "Gutenberg のブロックや埋め込みバリエーションをサイト全体でブロック挿入ツールから非表示にします。管理者がブロックごとに設定でき、GenerateBlocks との連携も任意で利用できます。"

#. Author of the plugin
#: block-inserter-filter.php
msgid "Jörn Gorres"
msgstr "Jörn Gorres"

#. Author URI of the plugin
#: block-inserter-filter.php
msgid "https://joern.gorres.com"
msgstr "https://joern.gorres.com"

#: includes/class-jgor-bif-admin-page.php:61
#: includes/class-jgor-bif-admin-page.php:62
#: includes/class-jgor-bif-admin-page.php:365
msgid "Hide Blocks"
msgstr "ブロックを非表示"

#: includes/class-jgor-bif-admin-page.php:139
